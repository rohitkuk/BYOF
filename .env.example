# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# ── LLM Provider ─────────────────────────────────────────────────────────────
BYOF_LLM_PROVIDER=anthropic        # anthropic | openai | ollama | openrouter | opencode
# BYOF_LLM_MODEL=                  # optional model override
# BYOF_LLM_FALLBACK_MODELS=big-pickle,minimax-m3  # tried in order if primary fails

# ── API Keys ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...       # console.anthropic.com
# OPENAI_API_KEY=sk-...            # platform.openai.com/api-keys
# OPENROUTER_API_KEY=sk-or-...     # openrouter.ai/keys  (free models available)
# OPENCODE_ZEN_API_KEY=...         # opencode.ai/auth    (free models available)

# Ollama: no key needed — set BYOF_LLM_PROVIDER=ollama, run `ollama serve`
